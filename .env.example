# Copy to .env.local at the project root and fill in your Supabase project's public settings.
# Restart npm run dev after changing these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only needed for server-side admin operations. Never prefix this with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
