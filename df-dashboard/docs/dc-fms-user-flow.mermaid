flowchart TD
    Start([User Opens App]) --> Login[Login Page]
    Login --> Role{Role?}

    %% ==============================
    %% SHARED: RECORD TABLE
    %% ==============================
    Role -->|Assistant| Table[Record Table]
    Role -->|Admin| Table

    subgraph RecordActions [Record Table Actions — Both Roles]
        direction LR
        Add[Add New Record]
        Edit[Edit Record]
        Pay[Record Payment]
        History[View Payment History]
    end

    Table --> RecordActions

    Add --> Form[Fill Form\nName, Diagnosis, Cost]
    Form --> Save1[Save] --> Table

    Edit --> Lookup[Search by Patient ID]
    Lookup --> Prefill[Form Prefilled] --> Save2[Save] --> Table

    Pay --> Dialog[Payment Dialog\nDate, Amount, Note]
    Dialog --> Save3[Save Payment]
    Save3 --> Sync[Sync Record Totals]
    Sync --> Table

    History --> Expand[Expand Row\nShow Installments] --> Table

    Table --> Lock{Cycle Locked?}
    Lock -->|No| RecordActions
    Lock -->|Yes| ReadOnly[Read-Only View]

    %% ==============================
    %% ADMIN ONLY: EXTRA MODULES
    %% ==============================
    Role -->|Admin| AdminModules[Admin Modules]

    subgraph AdminOnly [Admin Only]
        direction LR
        Dashboard[Dashboard]
        LabRecon[Lab Reconciliation]
        Overhead[Overhead Input]
        Closeout[Month-End Closeout]
    end

    AdminModules --> AdminOnly

    LabRecon --> Fees[Assign Lab Fees] --> Dashboard
    Overhead --> Expenses[Enter Expenses] --> Dashboard
    Dashboard --> KPIs[Revenue, Commission,\nProfit/Loss]

    Closeout --> Step1[Preview] --> Step2[Confirm]
    Step2 --> Partition{Settled?}
    Partition -->|Yes| Delete[Hard Delete]
    Partition -->|No| Carry[Carry Forward]
    Delete --> NewCycle[New Cycle]
    Carry --> NewCycle
    NewCycle --> Table
