    "font-weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "line-height": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.65
    },
    "letter-spacing": {
      "tight": "-0.02em",
      "normal": "0em",
      "wide": "0.025em"
    }
  },
  "color": {
