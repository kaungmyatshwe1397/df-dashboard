{
  "spacing": {
    "space-0": "0px",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "16px",
    "space-4": "24px",
    "space-5": "32px",
    "space-6": "40px",
    "space-7": "48px",
    "space-8": "64px"
  },
  "grid": {
    "columns": 12,
    "gutter": "24px",
    "margin": "32px",
    "container-max": "1280px"
  },
  "typography": {
    "font-family": {
      "heading": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "body": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
    },
    "font-size": {
      "display": "48px",
      "h1": "36px",
      "h2": "24px",
      "h3": "18px",
      "h4": "15px",
      "body-lg": "18px",
