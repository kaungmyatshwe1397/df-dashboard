        "inverse": "#0F172A"
      },
      "border": {
        "default": "#1E293B",
        "strong": "#334155"
      },
      "action": {
        "primary": "#818CF8",
        "primary-hover": "#6366F1",
        "primary-active": "#4F46E5",
        "secondary": "#1E1B4B"
      },
      "success": { "default": "#34D399", "surface": "#064E3B" },
      "warning": { "default": "#FBBF24", "surface": "#78350F" },
      "danger": { "default": "#F87171", "surface": "#7F1D1D" },
      "info": { "default": "#60A5FA", "surface": "#1E3A5F" }
