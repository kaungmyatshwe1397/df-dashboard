flowchart TD
    Start([User Opens App]) --> Login[Login Page\nEmail + Password]
    Login --> Signup[Sign Up Page]
    Signup --> Login

    Login --> Role{Role?}

    %% ==============================
    %% SHARED: RECORD TABLE
    %% ==============================
    Role -->|Assistant| Table[Record Table]
    Role -->|Admin| Table

    subgraph RecordActions [Record Table Actions — Both Roles]
        direction LR
        Add[Add New Record]
        Edit[Edit Record]
        Pay[Record Payment]
        History[View Payment History]
        DeleteRec[Delete Record]
    end

    Table --> RecordActions

    Add -->|GP| GpRecordPage[Full-page GP entry\nName, age, gender, optional address\nDate, treatment, cost]
    GpRecordPage --> GpSave[Atomic GP save\nVisit and month only, no registry write]
    GpSave --> DateMonth
    GpSave -->|Save and add another| GpRecordPage
    GpSave -->|Uncertain response| GpRetry[Preserve fields and submission ID\nLock changes and retry original request]
    GpRetry --> GpSave
    Add -->|Case| CaseRecordPage[One-page Case entry\nPatient/contact, treatment, payment\nOptional lab details]
    CaseRecordPage --> CaseSave[Atomic Case save\nMonth, case, optional receipt, retry ledger\nNo registry write]
    CaseSave --> DateMonth[Select destination month] --> Table
    CaseSave -->|Save and add another| CaseRecordPage
    CaseSave -->|Uncertain response| CaseRetry[Preserve and lock original request\nRetry same submission]
    CaseRetry --> CaseSave
    Edit --> VisitSearch[Filter visits in selected month/category]
    VisitSearch --> SelectVisit[Select actual visit by record UUID]
    SelectVisit --> Prefill2[Prefill demographics and treatment]
    Prefill2 --> Save3[Save details\nMove cycle if record date changed] --> DateMonth

    DeleteRec --> Confirm[Confirm Delete] --> Table
    NoteDelete["Deletes record only —\npatient stays in registry"]

    Pay --> Dialog[Payment Dialog\nDate, Amount, Note]
    Dialog --> Save4[Save Payment]
    Save4 --> Sync[Sync Record Totals]
    Sync --> Table

    History --> Expand[Expand Row\nShow Installments] --> Table

    %% ==============================
    %% BOTH ROLES: REGISTERED PATIENTS
    %% ==============================
    Role -->|Assistant| RegPatients[Patient Registration]
    Role -->|Admin| RegPatients

    RegPatients --> RegisteredTab[Registered tab]
    RegPatients --> UnregisteredTab[Unregistered tab\nName, address, demographics]
    RegisteredTab --> SearchPt[Search and filter profiles]
    UnregisteredTab --> SearchPt
    SearchPt --> PtDetail[Patient profile by UUID\nLegacy clinic-ID links still resolve]
    PtDetail --> RegPatients
    RegisteredTab --> RegisterNew[Register new patient\nReview possible existing profiles]
    UnregisteredTab --> Promote[Register existing UUID\nAssign clinic ID, retain visits]
    RegisteredTab --> Unregister[Mark unregistered\nRetain reserved ID and visits]
    Unregister --> UnregisteredTab
    Promote --> RegisteredTab
    SearchPt --> EditPt[Edit profile by UUID\nAtomically synchronize visit display copies]
    EditPt --> RegPatients

    %% ==============================
    %% ADMIN ONLY: EXTRA MODULES
    %% ==============================
    Role -->|Admin| AdminModules[Admin Modules]

    subgraph AdminOnly [Admin Only]
        direction LR
        Dashboard[Dashboard]
        LabRecon[Lab Reconciliation]
        Overhead[Overhead Input]
        CarryFwd[Carry Forward]
        UserMgmt[User Management]
        ChangePw[Change Password]
        MedHistOpts[Manage Medical History Options]
    end

    AdminModules --> AdminOnly

    LabRecon --> Fees[Assign Lab Fees] --> Dashboard
    Overhead --> Expenses[Enter Expenses] --> Dashboard
    Dashboard --> KPIs[Revenue, Commission,\nProfit/Loss]

    CarryFwd --> CF[Move unsettled CASE\nbalances to next month]
    CF --> NewBucket[Next month bucket auto-created]
    NewBucket --> Table

    UserMgmt --> EditUser[Edit Username/Password]
    UserMgmt --> DeleteAssistant[Delete Assistant Account]
    ChangePw --> VerifyCurrent[Verify Current Password] --> SetNew[Set New Password]
    MedHistOpts -.->|later| AddOpt[Add / Edit / Remove Option]
